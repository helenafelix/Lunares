<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light">Lista de Disciplinas</h2>
        <a href="/disciplinas/novo" class="btn btn-success btn-sm">Nova Disciplina</a>
    </div>
    <table class="table table-hover">
        <thead>
            <tr class="text-secondary small text-uppercase">
                <th>Código</th>
                <th>Matéria</th>
                <th>Professor</th>
                <th>Qtd. Aulas</th>
                <th>Faltas</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            {{#each disciplinas}}
            <tr>
                <td class="text-muted">{{codigo}}</td>
                <td class="fw-semibold">{{materia}}</td>
                <td>{{professor}}</td>
                <td>{{qtdAulas}}</td>
                <td>{{faltas}}</td>
                <td class="text-center">
                    <a href="/disciplinas/editar/{{codigo}}" class="btn btn-outline-primary btn-sm me-1">Editar</a>
                    <a href="/disciplinas/deletar/{{codigo}}" class="btn btn-outline-danger btn-sm" onclick="return confirm('Tem certeza que deseja excluir esta disciplina?')">Excluir</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
