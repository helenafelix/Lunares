<div class="container mt-5">
    <div class="border-bottom pb-3 mb-4">
        <h2 class="h4">Editar Disciplina: {{disciplina.materia}}</h2>
    </div>
    <div class="row">
        <div class="col-md-6">
            <form action="/disciplinas/update/{{disciplina.codigo}}" method="POST" class="bg-light p-4 rounded shadow-sm">
                <div class="mb-3">
                    <label class="form-label">Nome da Matéria</label>
                    <input type="text" name="materia" class="form-control" value="{{disciplina.materia}}" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Professor</label>
                    <input type="text" name="professor" class="form-control" value="{{disciplina.professor}}" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Quantidade de Aulas</label>
                    <input type="number" name="qtdAulas" class="form-control" value="{{disciplina.qtdAulas}}" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Faltas</label>
                    <input type="number" name="faltas" class="form-control" value="{{disciplina.faltas}}">
                </div>
                <div class="d-flex align-items-center">
                    <button type="submit" class="btn btn-primary me-3">Atualizar Disciplina</button>
                    <a href="/disciplinas" class="text-decoration-none text-muted">Cancelar e Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
