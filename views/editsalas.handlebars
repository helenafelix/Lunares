<div class="container mt-5">
    <div class="border-bottom pb-3 mb-4">
        <h2 class="h4">Editar Sala: {{sala.sala}}</h2>
    </div>
    <div class="row">
        <div class="col-md-6">
            <form action="/salas/update/{{sala.id_sala}}" method="POST" class="bg-light p-4 rounded shadow-sm">
                <div class="mb-3">
                    <label class="form-label">Nome da Sala</label>
                    <input type="text" name="sala" class="form-control" value="{{sala.sala}}" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Capacidade Máxima</label>
                    <input type="number" name="capacidade" class="form-control" value="{{sala.capacidade}}" required>
                </div>
                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="disponivel" id="disp" {{#if sala.disponivel}}checked{{/if}}>
                        <label class="form-check-label" for="disp">Sala Disponível</label>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <button type="submit" class="btn btn-primary me-3">Atualizar Registro</button>
                    <a href="/salas" class="text-decoration-none text-muted">Cancelar e Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
