<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light">Lista de Salas</h2>
        <a href="/salas/novo" class="btn btn-success btn-sm">Nova Sala</a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr class="text-secondary small text-uppercase">
                <th>ID</th>
                <th>Nome</th>
                <th>Disponibilidade</th>
                <th class="text-end">Capacidade</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            {{#each salas}}
            <tr>
                <td class="text-muted">{{id_sala}}</td>
                <td class="fw-semibold">{{sala}}</td>
                <td>
                    {{#if disponivel}}
                        <span class="text-success">● Disponível</span>
                    {{else}}
                        <span class="text-danger">● Ocupada</span>
                    {{/if}}
                </td>
                <td class="text-end text-muted">{{capacidade}}</td>
                <td class="text-center">
                    <a href="/salas/editar/{{id_sala}}" class="btn btn-outline-primary btn-sm me-1">Editar</a>
                    <a href="/salas/deletar/{{id_sala}}" class="btn btn-outline-danger btn-sm" onclick="return confirm('Tem certeza que deseja excluir esta sala?')">Excluir</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
