<div class="container mt-5">
    <div class="border-bottom pb-3 mb-4">
        <h2 class="h4">Cadastrar Novo Horário</h2>
    </div>
    <div class="row">
        <div class="col-md-6">
            <form action="/horarios/add" method="POST" class="bg-light p-4 rounded shadow-sm">
                <div class="mb-3">
                    <label class="form-label">Horário</label>
                    <input type="text" name="horarios" class="form-control" placeholder="Ex: 07:00" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Disciplina</label>
                    <select name="disciplinas" class="form-select" required>
                        <option value="">Selecione a Disciplina</option>
                        {{#each disciplinas}}
                        <option value="{{this.materia}}">{{this.materia}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Sala / Laboratório</label>
                    <select name="sala_lab" class="form-select" required>
                        <option value="">Selecione a Sala</option>
                        {{#each salas}}
                        <option value="{{this.sala}}">{{this.sala}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="d-flex align-items-center">
                    <button type="submit" class="btn btn-primary me-3">Salvar Horário</button>
                    <a href="/horarios" class="text-decoration-none text-muted">Cancelar e Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
